{
  "private": true,
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.15.0"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "format": "npm-run-all -p lint:fix prettier"
  },
  "devDependencies": {
    "@iconify-json/devicon-plain": "^1.2.59",
    "@iconify-json/material-symbols": "^1.2.92",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.96",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/robots": "6.2.3",
    "@nuxtjs/sitemap": "8.5.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.2",
    "@vueuse/core": "^14.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all": "^4.1.5",
    "nuxt": "^4.5.2",
    "nuxt-schema-org": "6.3.2",
    "nuxt-security": "2.6.0",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.0",
    "better-sqlite3": "^13.0.3",
    "typewriter-effect": "^2.22.0",
    "vue": "^3.5.43"
  },
  "packageManager": "pnpm@11.25.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": "prettier --write"
  }
}
